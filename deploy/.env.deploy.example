# === EC2 Deploy Configuration ===
# Elastic IP or public IP of your EC2 instance
EC2_HOST=1.2.3.4
# EC2 user (ubuntu for Ubuntu AMI)
EC2_USER=ubuntu
# SSH private key path
EC2_KEY=~/.ssh/your-key.pem
# Remote project directory
REMOTE_DIR=/home/ubuntu/iot-platform

# === MQTT credentials (will be written to mosquitto passwd file) ===
MQTT_GATEWAY_PASS=gateway123
MQTT_CLOUD_PASS=cloud123
MQTT_CLIENT_PASS=client123
MQTT_MONITOR_PASS=monitor123
MQTT_BRIDGE_PASS=bridge123

# === PostgreSQL credentials (used by docker-compose and cloud .env) ===
POSTGRES_USER=sb_user
POSTGRES_PASSWORD=sb_pass
POSTGRES_DB=sb_cloud

# === Cloud API .env overrides on EC2 ===
SB_DATABASE_URL=postgresql+asyncpg://sb_user:sb_pass@postgres:5432/sb_cloud
SB_MQTT_HOST=mosquitto
SB_MQTT_PORT=8883
SB_MQTT_USERNAME=cloud
SB_MQTT_PASSWORD=cloud123
SB_MQTT_TLS_ENABLED=true
SB_MQTT_MTLS_ENABLED=true
SB_MQTT_CA_CERT_PATH=/mosquitto/certs/ca.crt
SB_MQTT_CLIENT_CERT_PATH=/mosquitto/certs/clients/cloud.crt
SB_MQTT_CLIENT_KEY_PATH=/mosquitto/certs/clients/cloud.key
SB_TENANT_ID=hust
SB_SITE_ID=lab01
SB_GATEWAY_ID=gw-ubuntu-01
SB_API_HOST=0.0.0.0
SB_API_PORT=8000
# Set a stable production auth secret. If omitted, deploy preserves the
# existing remote secret or generates one on first deploy.
SB_AUTH_TOKEN_SECRET=

# HTTPS host for nginx and Let's Encrypt. Defaults to EC2_HOST when empty.
# Public IP certificates require Let's Encrypt's shortlived profile.
HTTPS_HOST=
