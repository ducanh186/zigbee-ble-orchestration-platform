# Production environment example for Zigbee Smart Building Platform.
# Copy to a secure environment-specific file outside git before deployment.
# Do not put real secrets in this repository.

# Public HTTPS endpoint
PROD_DOMAIN=<PROD_DOMAIN>

# FastAPI should be internal behind Nginx/reverse proxy in production.
SB_API_HOST=127.0.0.1
SB_API_PORT=8000

# Database must be private/internal only.
POSTGRES_USER=<DB_USER>
POSTGRES_PASSWORD=<DB_PASSWORD>
POSTGRES_DB=<DB_NAME>
SB_DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@postgres:5432/<DB_NAME>

# JWT/auth
SB_JWT_SECRET=<JWT_SECRET>
SB_ACCESS_TOKEN_TTL_SECONDS=900
SB_REFRESH_TOKEN_TTL_SECONDS=2592000

# MQTT production transport
SB_MQTT_HOST=mosquitto
SB_MQTT_PORT=8883
SB_MQTT_USERNAME=<MQTT_CLIENT_USERNAME>
SB_MQTT_PASSWORD=<MQTT_CLIENT_PASSWORD>
SB_MQTT_TLS_ENABLED=true
SB_MQTT_MTLS_ENABLED=true
SB_MQTT_CA_CERT_PATH=<MQTT_CA_CERT_PATH>
SB_MQTT_CLIENT_CERT_PATH=<MQTT_CLIENT_CERT_PATH>
SB_MQTT_CLIENT_KEY_PATH=<MQTT_CLIENT_KEY_PATH>

# Gateway identity
SB_TENANT_ID=<TENANT_ID>
SB_SITE_ID=<SITE_ID>
SB_GATEWAY_ID=<GATEWAY_ID>

# Operations
SB_BACKUP_RETENTION_DAYS=<BACKUP_RETENTION_DAYS>
SB_ALERT_WEBHOOK_URL=<ALERT_WEBHOOK_URL>

